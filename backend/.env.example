DATABASE_URL=postgresql+psycopg://readback:readback@localhost:5433/readback
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Token guarding GET /admin/export/events.csv (pilot data export)
ADMIN_TOKEN=readback-admin-dev

# Groq is used ONLY by scripts/generate_recaps.py (offline, at seed time).
# The running app never calls an LLM, so leaving this blank is fine - recaps
# just fall back to the extractive summaries. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
