DATABASE_URL=postgresql+psycopg://readback:readback@localhost:5433/readback
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Token guarding GET /admin/export/events.csv (pilot data export)
ADMIN_TOKEN=readback-admin-dev

# OpenRouter is used ONLY by the offline scripts (generate_recaps, tag_themes).
# The running app never calls an LLM for seeded books, so leaving this blank is fine - recaps
# just fall back to the extractive summaries. Never commit a real key.
OP_API_KEY=
OP_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Which provider the offline scripts and on-demand tagging use: openrouter or ollama.
LLM_PROVIDER=ollama
# Ollama cloud (key from ollama.com/settings/keys). Direct API model name has no -cloud suffix.
OLLAMA_API_KEY=
# Set true to tag the passage being read plus the next four, for books a reader switched on.
THEME_TAGGING_ON_DEMAND=true
